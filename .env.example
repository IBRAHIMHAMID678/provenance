# Insurance Document Intelligence Lab - Environment Configuration

# Server & Paths
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Database & Storage (Defaults to D: drive location)
DATABASE_URL=sqlite:///D:/PDF Extracter/backend/data/insurance_lab.db
STORAGE_ROOT=D:/PDF Extracter/backend/data

# Processing Limits
MAX_UPLOAD_SIZE_MB=25
MAX_PAGE_COUNT=100
ALLOWED_EXTENSIONS=["pdf"]

# Local OCR Configurations
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
ENABLE_PADDLE_OCR=False

# Optional LLM API Providers (Leave empty to use deterministic Mock Provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default LLM Models
DEFAULT_LLM_MODEL=mock-insurance-extractor-v1
DEFAULT_VISION_MODEL=mock-vision-extractor-v1

# Economics & Cost Accounting
HUMAN_REVIEWER_HOURLY_RATE=35.00
CPU_HOUR_COST=0.05
GPU_HOUR_COST=0.50
MOCK_LLM_INPUT_TOKEN_PRICE_PER_M=0.15
MOCK_LLM_OUTPUT_TOKEN_PRICE_PER_M=0.60

